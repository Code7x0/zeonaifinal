# Canonical public site URL (optional; defaults to https://zeonai.com)
NEXT_PUBLIC_SITE_URL=

# Resend API key for server-side Book a Demo email delivery (required for /api/demo)
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "ZeonAI <demo@mail.zeonai.com>")
RESEND_FROM_EMAIL=

# Optional secret used to sign the stateless cooldown cookie (falls back to RESEND_API_KEY)
DEMO_RATE_LIMIT_SECRET=

# Optional Upstash Redis REST credentials for distributed IP rate limiting on serverless deployments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
