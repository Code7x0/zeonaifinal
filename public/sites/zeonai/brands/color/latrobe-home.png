<header class="header"> 
    <div class="header__lockup">
        <button class="header__toggle-button btn btn--naked" data-action="toggle-menu">
            <svg id="button-icon-burger" viewBox="0 0 40 40" width="40" height="40">
                <use xlink:href="#icon-burger"></use>
            </svg>
            <svg id="button-icon-close" viewBox="0 0 40 40" width="40" height="40">
                <use xlink:href="#icon-close"></use>
            </svg>
        </button>
        
            
        <div class="header__navigation header__navigation--primary"> 
            <div class="header__navigation-wrapper">
                <div class="header__logo-lockup">
                    <a class="header__logo-link" href="https://www.latrobefinancial.com.au/" rel="home">
                                                    <svg class="header__logo" width="150" height="70" viewBox="0 0 150 70">
                                <use xlink:href="#ltf-logo"></use>
                            </svg>
                            <span class="visually-hidden">La Trobe Financial</span>
                                            </a>
